{
  "name": "spendward",
  "version": "0.1.0",
  "private": true,
  "description": "An authorization firewall between AI agents and PayPal. Agents can only spend what their owner signed off on.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "tsx --env-file=.env src/cli/setup.ts",
    "web": "tsx --env-file=.env src/web/server.ts",
    "demo": "./scripts/reset.sh && npm run mint --silent && SPENDWARD_PLANTED=1 SPENDWARD_UNATTENDED=1 npm run demo:agent --silent",
    "demo:live": "./scripts/reset.sh && npm run mint:live --silent && SPENDWARD_CATALOG=channel3 SPENDWARD_PLANTED=1 SPENDWARD_UNATTENDED=1 npm run demo:agent --silent",
    "mint": "tsx --env-file=.env src/cli/mint-mandate.ts",
    "mint:live": "tsx --env-file=.env src/cli/mint-mandate.ts --live",
    "reset": "./scripts/reset.sh",
    "tunnel": "./scripts/tunnel.sh",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "agent": "tsx --env-file=.env src/agent/shopper.ts",
    "demo:agent": "tsx --env-file=.env src/demo/agent-demo.ts",
    "demo:mcp": "tsx --env-file=.env src/demo/mcp-client.ts",
    "demo:scripted": "./scripts/reset.sh && npm run mint --silent && npm run demo:mcp --silent",
    "demo:spine": "tsx --env-file=.env src/demo/spine.ts",
    "mcp": "tsx --env-file=.env src/mcp/server.ts",
    "web:live": "npm run web",
    "redteam": "tsx --env-file=.env redteam/run.ts",
    "audit:verify": "tsx --env-file=.env src/cli/verify-audit.ts",
    "start": "tsx src/web/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
