# PayPal sandbox credentials - developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Secret used to sign mandates. Generate with: openssl rand -hex 32
MANDATE_SIGNING_KEY=

# LLM provider for the shopping agent and investigation explanations
ANTHROPIC_API_KEY=

# Channel3 product search - trychannel3.com/developers
CHANNEL3_API_KEY=

# Public origin PayPal redirects back to. Set this when running behind a
# tunnel or on Render; defaults to the request origin.
PUBLIC_URL=
