# PayPal sandbox credentials - developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Any OpenAI-compatible chat endpoint with tool calling. Used by the shopping
# agent and by the dashboard's mandate drafter.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: Channel3 live product search - trychannel3.com/developers
CHANNEL3_API_KEY=

# Public origin PayPal redirects back to. `npm run tunnel` sets it for you.
PUBLIC_URL=http://localhost:3000

# Webhook id from Apps & Credentials > your app > Webhooks. When set, every
# incoming event is verified against PayPal before it is trusted.
PAYPAL_WEBHOOK_ID=

# MANDATE_PRIVATE_KEY, MANDATE_PUBLIC_KEY and AUDIT_KEY are generated by
# `npm run setup`. Do not write them by hand.
